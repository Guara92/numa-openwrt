# Example only. The real config is generated on the router by
# `numa-ctl gen-config` (values depend on live uci/ubus state).
#
# [server] keys below MUST stay single-line `key = value`, because staging
# rewrites them with sed.

[server]
bind_addr     = "[::]:53"
api_port      = 5380
api_bind_addr = "<lan v4>"
data_dir      = "/etc/numa/state"
allow_from    = []                # allow all peers (numa default). LAN client source
                                  # prefixes churn (SLAAC ULA, rotating GUA) and cannot
                                  # be enumerated; the firewall keeps :53 off the WAN.
filter_aaaa   = false             # true suppresses AAAA/HTTPS on IPv4-only nets
max_concurrent_resolutions = 512  # cache-miss resolutions in flight; 0 is rejected upstream
rebind_protect        = false     # opt-in; keep off for split-horizon (local -> dnsmasq)
rebind_allowlist      = []        # domains exempt when rebind_protect = true
rebind_private_ranges = []        # empty -> upstream built-in private/special ranges

[upstream]
mode       = "forward"
# IP-literal DoH endpoints: same encryption as the hostname form, but no lookup
# of the upstream hostname, which would otherwise go out in plaintext from
# bootstrap_resolver to 9.9.9.9/1.1.1.1 over UDP:53 on every new connection.
# The https:// form matters: a bare IP here is treated as a plaintext UDP
# upstream and would be used on failover.
address    = ["https://9.9.9.9/dns-query"]
fallback   = ["https://1.1.1.1/dns-query"]   # DoH only: no plaintext leak on failover
timeout_ms = 800                  # upstream default is 5000
# After hedge_ms without an answer numa also asks the fallback (Cloudflare) and
# takes the first reply, so every hedge sends that query's name to a second
# operator. Median DoH time to Quad9 was ~30 ms from a workstation, so 50 ms would hedge a large
# share of cache misses; 200 ms is the upstream default. 0 = strict list order.
hedge_ms   = 200

[blocking]
refresh_hours = 6                 # upstream default is 24
lists = ["https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/pro-onlydomains.txt",
         "file:///etc/numa/canary-block.txt"]
                                  # jsdelivr instead of raw.githubusercontent (avoids 403/rate limits)
# allowlist entries are never blocked, subdomains included. Paths and URLs are
# fetched and refreshed with the lists, so a maintained whitelist needs no
# dashboard edits. A missing local file is non-fatal but logs an error on every
# refresh, so the package ships this one.
allowlist = ["file:///etc/numa/allow.txt"]

[cache]
max_entries = 100000
min_ttl     = 60
max_ttl     = 86400
warm        = ["cdn.jsdelivr.net"]

[[forwarding]]
suffix   = ["lan", "<dnsmasq domain>", "168.192.in-addr.arpa", "d.f.ip6.arpa"]
upstream = "127.0.0.1:5354"

[[zones]]
domain      = "canary.numa-ctl.internal"
record_type = "A"
value       = "192.0.2.53"
ttl         = 60

[proxy]
enabled = false

[dot]
enabled = false

[mobile]
enabled = false

[lan]
enabled = false
