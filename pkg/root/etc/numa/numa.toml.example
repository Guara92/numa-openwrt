# Example only. The real config is generated on the router by
# `numa-ctl gen-config` (values depend on live uci/ubus state).
#
# [server] keys below MUST stay single-line `key = value`, because staging
# rewrites them with sed.

[server]
bind_addr     = "[::]:53"
api_port      = 5380
api_bind_addr = "<lan v4>"
data_dir      = "/etc/numa/state"
allow_from    = ["<v4 nets of lan/iot/guest>", "<ULA prefixes>", "fe80::/10", "<lan GUA prefix>"]
               # --tailnet adds "100.64.0.0/10", "fd7a:115c:a1e0::/48"
filter_aaaa   = false             # true suppresses AAAA/HTTPS on IPv4-only nets
max_concurrent_resolutions = 512  # cache-miss resolutions in flight; 0 is rejected upstream
rebind_protect        = false     # opt-in; keep off for split-horizon (local -> dnsmasq)
rebind_allowlist      = []        # domains exempt when rebind_protect = true
rebind_private_ranges = []        # empty -> upstream built-in private/special ranges

[upstream]
mode       = "forward"
address    = ["https://dns.quad9.net/dns-query"]
fallback   = ["https://cloudflare-dns.com/dns-query"]   # DoH only: no plaintext leak on failover
timeout_ms = 800                  # upstream default is 5000
hedge_ms   = 50                   # parallel query after 50ms of silence; 0 disables

[blocking]
refresh_hours = 6                 # upstream default is 24
lists = ["https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/pro-onlydomains.txt",
         "file:///etc/numa/canary-block.txt"]
                                  # jsdelivr instead of raw.githubusercontent (avoids 403/rate limits)

[cache]
max_entries = 100000
min_ttl     = 60
max_ttl     = 86400
warm        = ["cdn.jsdelivr.net"]

[[forwarding]]
suffix   = ["lan", "<dnsmasq domain>", "168.192.in-addr.arpa", "d.f.ip6.arpa"]
upstream = "127.0.0.1:5354"

[[zones]]
domain      = "canary.numa-ctl.internal"
record_type = "A"
value       = "192.0.2.53"
ttl         = 60

[proxy]
enabled = false

[dot]
enabled = false

[mobile]
enabled = false

[lan]
enabled = false
